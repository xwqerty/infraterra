{
  "name": "infraterra-display-client",
  "version": "1.0.0",
  "description": "Digital Advertisement Display Client for PC Sticks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "Infraterra",
  "license": "MIT",
  "dependencies": {
    "aws-iot-device-sdk": "^2.2.11",
    "aws-sdk": "^2.1015.0",
    "electron-store": "^8.1.0",
    "node-schedule": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^23.1.1",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.infraterra.display",
    "productName": "Infraterra Display",
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infraterra Display"
    }
  }
}